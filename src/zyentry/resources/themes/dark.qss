QMainWindow, QWidget#Central { background: #071426; color: #eef6ff; font-family: Inter, "Noto Sans", Arial, sans-serif; }
QScrollArea#StepsScroll, QWidget#StepsContainer { background: transparent; }
QLabel { color: #eef3ff; }
QLabel[muted="true"] { color: #b8c0cc; }
QDialog, QFrame#Header, QFrame#Footer, QFrame#StepCard { background: rgba(10, 31, 58, 0.94); border: 1px solid #1d4f86; border-radius: 12px; }
QFrame#Logo { border: 2px solid #facc15; border-radius: 12px; background: #08203d; }
QLabel#LogoText { color: #ffffff; font-size: 21px; font-weight: 800; }
QLabel#Title { font-size: 29px; font-weight: 800; }
QLabel#Subtitle { font-size: 14px; color: #b8d4f5; }
QLabel#StepTitle { font-size: 18px; font-weight: 800; }
QLabel#StepDesc { font-size: 14px; color: #c4ccd8; }
QLabel#Badge { border: 2px solid #facc15; border-radius: 23px; color: #fef9c3; font-size: 22px; font-weight: 800; background: #08203d; }
QLineEdit, QComboBox, QPlainTextEdit { background: #08203d; border: 1px solid #2f6fa8; border-radius: 7px; color: #eef6ff; padding: 9px 12px; selection-background-color: #facc15; selection-color: #102033; }
QPlainTextEdit { font-family: "JetBrains Mono", "Noto Sans Mono", monospace; font-size: 13px; }
QPushButton { background: #08203d; border: 1px solid #2f6fa8; border-radius: 7px; color: #f3f8ff; padding: 9px 15px; font-weight: 700; }
QPushButton:hover { border-color: #facc15; background: #0b2b52; }
QPushButton:checked { border-color: #facc15; background: #12345c; }
QComboBox#LanguageCombo { min-height: 34px; padding: 6px 8px; font-weight: 700; }
QComboBox#LanguageCombo::drop-down { border: 0; width: 18px; }
QComboBox#LanguageCombo QAbstractItemView { background: #08203d; border: 1px solid #2f6fa8; color: #eef6ff; selection-background-color: #facc15; selection-color: #102033; padding: 6px; }
QPushButton#PrimaryButton, QPushButton#SecondaryButton { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0ea5e9, stop:1 #1d4ed8); border: 1px solid #facc15; color: white; padding: 14px 20px; font-size: 15px; min-height: 20px; }
QPushButton#SecondaryButton { background: #0b2b52; border: 1px solid #facc15; color: #fef9c3; }
QPushButton#SecondaryButton:hover { background: #12345c; border-color: #fde047; }
QPushButton#PrimaryButton:disabled { background: #1f3a5f; border-color: #355f8f; color: #8fb4d8; }
QPushButton#HelpButton { border-radius: 16px; min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px; padding: 0; font-size: 17px; }
QPushButton#AboutButton { padding: 6px 10px; font-size: 12px; border-radius: 6px; }
QCheckBox { color: #eef3ff; spacing: 9px; }
QCheckBox::indicator { width: 19px; height: 19px; border: 1px solid #7fb3e6; border-radius: 3px; background: #08203d; }
QCheckBox::indicator:checked { background: #facc15; border-color: #fde047; }
QCheckBox#ThemeSwitch { min-width: 58px; max-width: 58px; min-height: 30px; max-height: 30px; spacing: 0; }
QCheckBox#ThemeSwitch::indicator { width: 58px; height: 30px; border-radius: 15px; border: 1px solid #2f6fa8; background: #08203d; }
QCheckBox#ThemeSwitch::indicator:unchecked { image: none; background: #08203d; }
QCheckBox#ThemeSwitch::indicator:checked { image: none; background: #dbeafe; border-color: #facc15; }
QCheckBox#ThemeSwitch::indicator:unchecked:hover { border-color: #facc15; }
QCheckBox#ThemeSwitch::indicator:checked:hover { border-color: #f59e0b; }
QLabel#ThemeIcon { color: #facc15; font-size: 16px; font-weight: 800; padding: 0; }
QLabel#StatusText { color: #fbbf24; }
QLabel#IconPreview { border: 1px dashed #7fb3e6; border-radius: 8px; background: #08203d; color: #7fb3e6; }
QLabel#Pill { border: 1px solid #facc15; border-radius: 10px; padding: 6px 10px; color: #fef9c3; background: #08203d; }
QPlainTextEdit#PreviewText { min-height: 360px; }
QDialogButtonBox QPushButton { min-width: 96px; }
QDialog#AboutDialog QLabel { line-height: 130%; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 0; }
QScrollBar::handle:vertical { background: #1d4f86; border-radius: 5px; min-height: 40px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
